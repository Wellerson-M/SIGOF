# SIGOF — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA é versionado (ver .gitignore e RFC seção 5.8).

# --- Aplicação ---
NODE_ENV=development
PORT=3333

# --- Banco de dados (PostgreSQL) ---
# Em desenvolvimento, corresponde ao serviço "postgres" do docker-compose.yml
DATABASE_URL=postgresql://sigof:sigof@localhost:5432/sigof?schema=public

# --- Autenticação (RNF03) ---
# Em produção, gere um segredo forte: openssl rand -base64 32
JWT_SECRET=somente-desenvolvimento-troque-em-producao
# Vida do token de acesso (minutos); duração máxima do login (horas, um
# expediente) e tempo sem uso até a sessão acabar (minutos). Os cookies
# somem ao fechar o navegador.
ACESSO_MINUTOS=15
SESSAO_HORAS=12
SESSAO_INATIVIDADE_MINUTOS=120

# --- Frontend (única origem autorizada a chamar a API com cookies) ---
FRONTEND_URL=http://localhost:3000

# --- Cifra dos segredos guardados no banco (ex.: senha do e-mail de envio) ---
# Obrigatória em staging e produção: openssl rand -hex 32
# Em desenvolvimento, sem ela, vale uma chave fixa só para testes
# CHAVE_CIFRA=

# --- Caixa de sugestões do ambiente de testes ---
# Para onde vai o que as pessoas escrevem no botão "Sugestões" (sai pelo
# e-mail configurado da empresa). Sem ela, o botão não aparece.
# SUGESTOES_EMAIL=

# --- Fila de e-mails: de quantos em quantos segundos tenta enviar ---
EMAIL_INTERVALO_SEGUNDOS=15

# --- Storage de anexos (S3-compatível — SeaweedFS em desenvolvimento) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=sigof-anexos
STORAGE_ACCESS_KEY=sigof
STORAGE_SECRET_KEY=sigof-secret

# Os parâmetros de atendimento (SLA, expediente, fuso, janela de
# duplicidade) ficam na tabela de empresas: cada transportadora tem os seus.

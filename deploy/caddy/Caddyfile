# Caddy: recebe o tráfego HTTPS e entrega ao contêiner certo.
# Telas e API no mesmo endereço: /api e /health vão para a API, o resto para
# as telas. Assim o cookie de sessão funciona sem liberar acesso entre sites.
# O certificado é obtido e renovado sozinho (Let's Encrypt).

{$DOMINIO_STAGING} {
	encode zstd gzip

	header {
		# Navegador só fala HTTPS com este site pelos próximos 6 meses
		Strict-Transport-Security "max-age=15552000"
		-Server
	}

	handle /api/* {
		reverse_proxy api-staging:3333
	}

	handle /health {
		reverse_proxy api-staging:3333
	}

	handle {
		reverse_proxy web-staging:3000
	}
}

// Modelo de dados do SIGOF (RFC seções 5.2 e 5.5).
//
// Toda tabela de negócio — inclusive as filhas da solicitação, como
// mensagens e anexos — carrega `empresaId`, que é a chave de isolamento
// multi-tenant. O filtro por empresa é aplicado no backend a partir do
// usuário autenticado — nunca a partir de parâmetro enviado pelo cliente.

generator client {
  provider = "prisma-client-js"
}

// A connection string é definida em prisma.config.ts (Prisma 7+).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Enums

enum Perfil {
  SOLICITANTE
  ANALISTA
  SUPERVISOR
  ADMIN
}

enum Area {
  FINANCEIRO
  COMERCIAL
  OPERACIONAL
}

enum TipoOcorrencia {
  REVERSAO
  TROCA_PAGADOR
  AJUSTE_FISCAL
  OUTRO
}

enum StatusSolicitacao {
  NOVO
  EM_ANDAMENTO
  AGUARDANDO_DOC
  ESCALADO
  RESOLVIDO
  CANCELADO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

/// O que aconteceu, na trilha de auditoria.
enum AcaoDeAuditoria {
  LOGIN
  LOGIN_RECUSADO
  SAIDA
  SENHA_ALTERADA
  USUARIO_CRIADO
  USUARIO_ALTERADO
  SENHA_REDEFINIDA
  EMPRESA_ALTERADA
  EMAIL_CONFIGURADO
  /// Cadastro auxiliar da empresa (filial, causa de erro...) criado ou alterado.
  CADASTRO_ALTERADO
}

/// Em que momento o arquivo entrou: o detalhe mostra cada grupo separado.
enum EtapaDoAnexo {
  /// Junto com a abertura (o que o solicitante mandou de início)
  ABERTURA
  /// Durante o atendimento, inclusive pela conversa
  ANDAMENTO
  /// Ao resolver (o documento final)
  RESOLUCAO
}

enum SituacaoDoEmail {
  PENDENTE
  ENVIADO
  /// Esgotou as tentativas; fica registrado com o último erro.
  FALHOU
}

// ------------------------------------------------------------- Entidades

/// Transportadora. No MVP existe apenas a empresa piloto, mas é a chave que
/// viabiliza a evolução para SaaS multi-transportadora (RFC seção 1.7).
model Empresa {
  id          String   @id @default(uuid())
  razaoSocial String   @map("razao_social")
  cnpj        String   @unique
  /// Identificador curto usado no login (ex.: `transportadora-demo`). É o que
  /// diz a qual empresa o usuário pertence, já que o mesmo e-mail pode existir
  /// em duas transportadoras.
  slug        String   @unique
  ativa       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")

  // --- Parâmetros de atendimento (RFC seção 2.5) ---
  // Ficam na empresa, e não fixos no código, porque cada transportadora tem
  // seu expediente e seu prazo. O SLA gravado na solicitação é calculado com
  // estes valores no momento da abertura.

  /// Fuso IANA usado para saber quando começa e termina o expediente.
  fusoHorario            String  @default("America/Sao_Paulo") @map("fuso_horario")
  /// Início do expediente, em minutos desde a meia-noite (480 = 08:00).
  expedienteInicioMinuto Int     @default(480) @map("expediente_inicio_minuto")
  /// Fim do expediente, em minutos desde a meia-noite (1080 = 18:00).
  expedienteFimMinuto    Int     @default(1080) @map("expediente_fim_minuto")
  /// Dias úteis da semana (0 = domingo ... 6 = sábado).
  diasUteis              Int[]   @default([1, 2, 3, 4, 5]) @map("dias_uteis")
  /// Prazo para o atendimento inicial, em minutos úteis (240 = 4 horas).
  slaAtendimentoMinutos  Int     @default(240) @map("sla_atendimento_minutos")
  /// Janela de detecção de duplicidade de CTe/NF, em dias corridos.
  janelaDuplicidadeDias  Int     @default(7) @map("janela_duplicidade_dias")
  /// Ao resolver, a causa do erro (controle interno) é obrigatória.
  exigirCausaAoResolver  Boolean @default(false) @map("exigir_causa_ao_resolver")
  /// Caixas de e-mail que recebem cópia de toda ocorrência e
  /// movimentação, como registro e backup (o setor, o gerente...).
  emailsCaixaCentral     String[] @default([]) @map("emails_caixa_central")

  // --- E-mail de saída (RF13) ---
  // Cada empresa envia pela própria conta (ex.: Gmail com senha de app),
  // configurada pelo administrador na tela. A senha fica cifrada com
  // AES-256-GCM; a chave só existe no servidor (CHAVE_CIFRA).

  /// Enquanto estiver desligado, nada é posto na fila de envio.
  emailAtivo          Boolean @default(false) @map("email_ativo")
  smtpServidor        String? @map("smtp_servidor")
  smtpPorta           Int?    @map("smtp_porta")
  /// true = TLS desde o início (porta 465); false = STARTTLS (porta 587).
  smtpTlsDireto       Boolean @default(true) @map("smtp_tls_direto")
  smtpUsuario         String? @map("smtp_usuario")
  smtpSenhaCifrada    String? @map("smtp_senha_cifrada")
  /// Nome que aparece como remetente ("SIGOF — Transportadora Demo").
  emailRemetenteNome  String? @map("email_remetente_nome")
  /// Quais acontecimentos geram e-mail (os outros ficam só no sino).
  emailEventos        String[] @default(["ABERTA", "STATUS", "MENSAGEM", "ANEXO"]) @map("email_eventos")

  usuarios     Usuario[]
  solicitacoes Solicitacao[]
  sequencias   SequenciaProtocolo[]
  mensagens    Mensagem[]
  anexos       Anexo[]
  historicos   StatusHistorico[]
  notificacoes Notificacao[]
  sessoes      Sessao[]
  auditoria    EventoAuditoria[]
  emails       EmailSaida[]
  filiais      Filial[]
  causas       CausaDeErro[]

  @@map("empresas")
}

model Usuario {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  nome      String
  email     String
  senhaHash String   @map("senha_hash")
  perfil    Perfil
  area      Area?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  // --- Proteção contra força bruta (RNF03) ---
  /// Falhas de senha seguidas desde o último login bem-sucedido.
  falhasDeLogin Int       @default(0) @map("falhas_de_login")
  /// Enquanto estiver no futuro, o login é recusado mesmo com a senha certa.
  bloqueadoAte  DateTime? @map("bloqueado_ate")

  /// A senha foi definida pelo administrador (provisória): no próximo
  /// login a pessoa é levada a escolher a dela antes de usar o sistema.
  trocarSenha    Boolean   @default(false) @map("trocar_senha")
  ultimoAcessoEm DateTime? @map("ultimo_acesso_em")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  solicitacoesAbertas    Solicitacao[]     @relation("SolicitacoesAbertas")
  solicitacoesAtribuidas Solicitacao[]     @relation("SolicitacoesAtribuidas")
  mensagens              Mensagem[]
  historicos             StatusHistorico[]
  notificacoes           Notificacao[]
  anexos                 Anexo[]
  sessoes                Sessao[]
  auditoriaFeita         EventoAuditoria[] @relation("AuditoriaAutor")
  auditoriaSofrida       EventoAuditoria[] @relation("AuditoriaAlvo")

  // O e-mail é único dentro da empresa, não globalmente: em um cenário
  // multi-tenant, a mesma pessoa pode existir em duas transportadoras.
  @@unique([empresaId, email])
  @@index([empresaId])
  @@map("usuarios")
}

/// Sessão de login, representada pelo refresh token.
///
/// O token em si nunca é gravado, só o hash SHA-256 dele: quem ler o banco
/// não consegue se passar pelo usuário. A cada renovação a sessão é
/// substituída por uma nova da mesma `familia`; se um token já substituído
/// for apresentado de novo, alguém o copiou, e a família inteira é revogada.
model Sessao {
  id            String    @id @default(uuid())
  empresaId     String    @map("empresa_id")
  usuarioId     String    @map("usuario_id")
  familia       String
  tokenHash     String    @unique @map("token_hash")
  expiraEm      DateTime  @map("expira_em")
  substituidaEm DateTime? @map("substituida_em")
  revogadaEm    DateTime? @map("revogada_em")
  /// A sessão que nasceu da renovação desta. Serve para reconhecer uma
  /// resposta de renovação que se perdeu (a sucessora nunca foi usada).
  substituidaPorId String? @map("substituida_por_id")
  /// Nasceu de uma resposta perdida: há um teto por família.
  recuperada    Boolean   @default(false)
  ip            String?
  userAgent     String?   @map("user_agent")
  criadoEm      DateTime  @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([familia])
  @@map("sessoes")
}

model Solicitacao {
  id        String @id @default(uuid())
  empresaId String @map("empresa_id")

  /// Formato SOL-AAAA-MM-NNNN. Único por empresa (não globalmente), para
  /// que cada transportadora tenha sua própria numeração no modelo SaaS.
  protocolo String

  solicitanteId String  @map("solicitante_id")
  responsavelId String? @map("responsavel_id")
  /// Filial que emitiu o documento. Duas filiais podem ter CTe com o mesmo
  /// número, então a duplicidade compara documento + filial.
  filialId      String? @map("filial_id")

  tipo           TipoOcorrencia
  /// O primeiro CTe e a primeira NF (o que aparece no cartão e no assunto
  /// do e-mail). A lista completa fica em `ctes` e `nfs`.
  cte            String?
  nf             String?
  /// Todos os documentos: uma fatura inteira pode ter vários CTe e NF.
  ctes           String[]       @default([])
  nfs            String[]       @default([])
  /// Número da fatura, quando a correção é da fatura inteira.
  fatura         String?
  pagadorCorreto String?        @map("pagador_correto")
  descricao      String

  status     StatusSolicitacao @default(NOVO)
  prioridade Prioridade        @default(MEDIA)

  // --- Controle de SLA (RFC seções 2.5 e 3.2) ---
  // O prazo é calculado em minutos úteis a partir da abertura. Enquanto a
  // solicitação fica em AGUARDANDO_DOC o relógio para: `slaPausadoEm` marca
  // o início da pausa e `slaMinutosPausados` acumula o tempo já pausado.
  slaVenceEm         DateTime? @map("sla_vence_em")
  slaPausadoEm       DateTime? @map("sla_pausado_em")
  slaMinutosPausados Int       @default(0) @map("sla_minutos_pausados")

  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  resolvidoEm  DateTime? @map("resolvido_em")

  // --- Causa do erro (controle interno; nunca vai para e-mail nem para o
  // solicitante). Informada ao resolver. O detalhe é gravado como texto:
  // se a lista de opções mudar, o registro antigo continua dizendo o que foi.
  causaId         String? @map("causa_id")
  causaDetalhe    String? @map("causa_detalhe")
  causaComentario String? @map("causa_comentario")

  /// Registro rápido: algo que a equipe já resolveu por fora (WhatsApp,
  /// telefone) e só registra para ter o histórico. Nasce resolvida, sem
  /// SLA e sem avisos; fica fora do tempo médio de resolução.
  registroRapido Boolean @default(false) @map("registro_rapido")

  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  solicitante Usuario  @relation("SolicitacoesAbertas", fields: [solicitanteId], references: [id])
  responsavel Usuario? @relation("SolicitacoesAtribuidas", fields: [responsavelId], references: [id])
  filial      Filial?  @relation(fields: [filialId], references: [id])
  causa       CausaDeErro? @relation(fields: [causaId], references: [id])

  mensagens    Mensagem[]
  anexos       Anexo[]
  historicos   StatusHistorico[]
  notificacoes Notificacao[]
  emails       EmailSaida[]

  @@unique([empresaId, protocolo])
  // Índices que sustentam a detecção de duplicidade (RF09): a busca é
  // sempre por empresa + documento dentro da janela de 7 dias.
  @@index([empresaId, cte])
  @@index([empresaId, nf])
  @@index([ctes], type: Gin)
  @@index([nfs], type: Gin)
  @@index([empresaId, status])
  @@map("solicitacoes")
}

/// Filial da transportadora, cadastrada pelo administrador. Cada filial
/// emite CTe com numeração própria (é outro CNPJ ou outra série).
model Filial {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  nome      String
  /// Desativada some dos formulários, mas continua nas solicitações antigas.
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  solicitacoes Solicitacao[]

  @@unique([empresaId, nome])
  @@map("filiais")
}

/// De quem foi o erro que gerou a solicitação, para o controle interno da
/// empresa (quantos erros de digitação, de cliente, comerciais...). Cada
/// empresa monta a sua lista.
model CausaDeErro {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  nome      String
  /// Escolhas do "qual" (ex.: os digitadores em "Erro de digitação").
  /// Vazio: a causa não tem detalhe a escolher.
  opcoes    String[] @default([])
  /// Como o "qual" aparece na tela (ex.: "Digitador").
  rotuloDasOpcoes String? @map("rotulo_das_opcoes")
  ordem     Int      @default(0)
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  solicitacoes Solicitacao[]

  @@unique([empresaId, nome])
  @@map("causas_de_erro")
}

/// Contador de protocolo por empresa/ano/mês.
///
/// Uma linha por competência, incrementada dentro da mesma transação que
/// cria a solicitação. Isso evita que duas aberturas simultâneas recebam o
/// mesmo número — o que aconteceria com uma contagem do tipo
/// `SELECT COUNT(*) + 1`.
model SequenciaProtocolo {
  empresaId String @map("empresa_id")
  ano       Int
  mes       Int
  ultimo    Int    @default(0)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@id([empresaId, ano, mes])
  @@map("sequencias_protocolo")
}

model Mensagem {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  solicitacaoId String   @map("solicitacao_id")
  autorId       String   @map("autor_id")
  conteudo      String
  /// true = comentário interno entre analistas; false = visível ao solicitante
  interna       Boolean  @default(false)
  criadoEm      DateTime @default(now()) @map("criado_em")

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id])
  autor       Usuario     @relation(fields: [autorId], references: [id])
  anexos      Anexo[]

  @@index([empresaId, solicitacaoId])
  @@map("mensagens")
}

model Anexo {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  solicitacaoId String   @map("solicitacao_id")
  enviadoPorId  String   @map("enviado_por_id")
  nomeArquivo   String   @map("nome_arquivo")
  /// Chave no storage S3-compatível, prefixada por empresa (RFC seção 5.5)
  chaveStorage  String   @map("chave_storage")
  tipoMime      String   @map("tipo_mime")
  tamanhoBytes  Int      @map("tamanho_bytes")
  /// SHA-256 do conteúdo: o mesmo arquivo enviado em outra solicitação
  /// (com outro CTe digitado, por exemplo) também gera alerta de duplicidade.
  sha256        String?
  etapa         EtapaDoAnexo @default(ANDAMENTO)
  /// Enviado junto com uma mensagem da conversa (aparece nela, com link).
  mensagemId    String?      @map("mensagem_id")
  criadoEm      DateTime @default(now()) @map("criado_em")

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id])
  enviadoPor  Usuario     @relation(fields: [enviadoPorId], references: [id])
  mensagem    Mensagem?   @relation(fields: [mensagemId], references: [id])

  @@index([empresaId, solicitacaoId])
  @@index([empresaId, sha256])
  @@map("anexos")
}

/// Trilha de auditoria imutável das mudanças de status (RNF09).
/// Registros são apenas inseridos, nunca alterados ou removidos.
model StatusHistorico {
  id             String             @id @default(uuid())
  empresaId      String             @map("empresa_id")
  solicitacaoId  String             @map("solicitacao_id")
  autorId        String             @map("autor_id")
  statusAnterior StatusSolicitacao? @map("status_anterior")
  statusNovo     StatusSolicitacao  @map("status_novo")
  observacao     String?
  criadoEm       DateTime           @default(now()) @map("criado_em")

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id])
  autor       Usuario     @relation(fields: [autorId], references: [id])

  @@index([empresaId, solicitacaoId])
  @@map("status_historicos")
}

model Notificacao {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  usuarioId     String   @map("usuario_id")
  solicitacaoId String   @map("solicitacao_id")
  mensagem      String
  lida          Boolean  @default(false)
  criadoEm      DateTime @default(now()) @map("criado_em")

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id])

  @@index([empresaId, usuarioId, lida])
  @@map("notificacoes")
}

/// Trilha de auditoria de acesso e administração (RNF09).
///
/// Só recebe inserções: a API não tem rota que altere ou apague um evento,
/// e o banco recusa UPDATE nesta tabela (gatilho criado na migração).
model EventoAuditoria {
  id        String          @id @default(uuid())
  empresaId String          @map("empresa_id")
  /// Quem fez. Nulo quando não há usuário identificado.
  autorId   String?         @map("autor_id")
  /// Sobre quem foi feito (o usuário criado, alterado, que tentou entrar...).
  alvoId    String?         @map("alvo_id")
  acao      AcaoDeAuditoria
  /// O que mudou, com os valores antes e depois quando houver.
  detalhes  Json?
  ip        String?
  criadoEm  DateTime        @default(now()) @map("criado_em")

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  autor   Usuario? @relation("AuditoriaAutor", fields: [autorId], references: [id])
  alvo    Usuario? @relation("AuditoriaAlvo", fields: [alvoId], references: [id])

  @@index([empresaId, criadoEm])
  @@map("eventos_auditoria")
}

/// Fila de e-mails de saída (padrão "outbox").
///
/// O e-mail é gravado na mesma transação da movimentação que o gerou e
/// enviado depois, por um processo em segundo plano. Se o provedor de
/// e-mail estiver fora do ar, a movimentação acontece do mesmo jeito e o
/// envio é tentado de novo, com espera crescente.
model EmailSaida {
  id            String          @id @default(uuid())
  empresaId     String          @map("empresa_id")
  /// Nulo no e-mail de teste da configuração.
  solicitacaoId String?         @map("solicitacao_id")
  para          String[]
  assunto       String
  texto         String
  html          String
  /// Cabeçalhos que fazem o Gmail e o Outlook mostrarem todos os e-mails
  /// de um protocolo como uma única conversa.
  messageId     String          @unique @map("message_id")
  respondendoA  String?         @map("respondendo_a")
  situacao      SituacaoDoEmail @default(PENDENTE)
  tentativas    Int             @default(0)
  /// Quando pode ser tentado (de novo). Também serve de reserva: quem pega
  /// o e-mail para enviar empurra este horário para a frente.
  tentarEm      DateTime        @default(now()) @map("tentar_em")
  ultimoErro    String?         @map("ultimo_erro")
  /// Os acontecimentos que este e-mail conta (vários seguidos viram um só).
  itens         Json?
  /// Até quando um acontecimento novo da mesma solicitação entra neste
  /// e-mail em vez de gerar outro. Nulo: já saiu para envio.
  agruparAte    DateTime?       @map("agrupar_ate")
  enviadoEm     DateTime?       @map("enviado_em")
  criadoEm      DateTime        @default(now()) @map("criado_em")

  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  solicitacao Solicitacao? @relation(fields: [solicitacaoId], references: [id])

  @@index([situacao, tentarEm])
  @@index([empresaId, solicitacaoId])
  @@map("emails_saida")
}
